@using ASP_NET_Core.Models

@(Html.DevExtreme().DataGrid<SampleOrder>()
    .ID("dataGrid")
    .ElementAttr(new { @class = "dx-card" })
    .DataSource(new JS("sharedDataSource"))
    .RemoteOperations(true)
    .AllowColumnReordering(true)
    .Pager(pager => pager
        .ShowPageSizeSelector(true)
        .ShowInfo(true)
        .AllowedPageSizes(new JS("[5, 10, 20]"))
    )
    .Paging(paging => paging.PageSize(10))
    .Selection(selection => selection.Mode(SelectionMode.Multiple))
    .ColumnChooser(columnChooser => columnChooser.Enabled(true))
    .SearchPanel(searchPanel => searchPanel.Visible(true))
    .HeaderFilter(headerFilter => headerFilter.Visible(true))
    .FilterPanel(filterPanel => filterPanel.Visible(true))
    .Editing(editing => editing
        .Mode(GridEditMode.Popup)
        .AllowUpdating(true)
        .AllowAdding(true)
        .AllowDeleting(true)
    )
    .Columns(columns =>
    {
        columns.AddFor(m => m.OrderID).AllowEditing(false);
        columns.AddFor(m => m.ShipName);
        columns.AddFor(m => m.ShipCountry);
        columns.AddFor(m => m.OrderDate).DataType(GridColumnDataType.Date);
        columns.AddFor(m => m.Freight).HeaderFilter(headerFilter => headerFilter.GroupInterval(100));
    })
    .Height(800)
    .Visible(new JS("!isScreenSmall"))
    .ShowBorders(true)
    .ColumnAutoWidth(true)
)

@(Html.DevExtreme().CardView<SampleOrder>()
    .ID("cardView")
    .ElementAttr(new { @class = "dx-card" })
    .DataSource(new JS("sharedDataSource"))
    .RemoteOperations(true)
    .AllowColumnReordering(true)
    .Pager(pager => pager
        .ShowPageSizeSelector(true)
        .ShowInfo(true)
        .AllowedPageSizes(new JS("[5, 10, 20]"))
    )
    .Paging(paging => paging.PageSize(10))
    .Selection(selection => selection.Mode(SingleMultipleOrNone.Multiple))
    .ColumnChooser(columnChooser => columnChooser.Enabled(true))
    .SearchPanel(searchPanel => searchPanel.Visible(true))
    .HeaderFilter(headerFilter => headerFilter.Visible(true))
    .FilterPanel(filterPanel => filterPanel.Visible(true))
    .Editing(editing => editing
        .AllowUpdating(true)
        .AllowAdding(true)
        .AllowDeleting(true)
    )
    .Columns(columns =>
    {
        columns.AddFor(m => m.OrderID).AllowEditing(false);
        columns.AddFor(m => m.ShipName);
        columns.AddFor(m => m.ShipCountry);
        columns.AddFor(m => m.OrderDate).DataType(GridColumnDataType.Date);
        columns.AddFor(m => m.Freight).HeaderFilter(headerFilter => headerFilter.GroupInterval(100));
    })
    .Height(800)
    .Visible(new JS("isScreenSmall"))
    .CardsPerRow(Mode.Auto)
)

<script>
    const sharedDataSource = new DevExpress.data.DataSource({
        store: DevExpress.data.AspNet.createStore({
            key: 'OrderID',
            loadUrl: '@Url.Action("Get", "SampleData")',
            insertUrl: '@Url.Action("Post", "SampleData")',
            updateUrl: '@Url.Action("Put", "SampleData")',
            deleteUrl: '@Url.Action("Delete", "SampleData")',
            onBeforeSend(method, ajaxOptions) {
                ajaxOptions.xhrFields = { withCredentials: true };
            },
        }),
    });

    let isScreenSmall = $(window).width() < 960;

    $(() => {
        const dataGrid = $('#dataGrid').dxDataGrid('instance');
        const cardView = $('#cardView').dxCardView('instance');

        new SyncHelper(dataGrid, cardView);

        $(window).on('resize', () => {
            isScreenSmall = $(window).width() < 960;
            if (isScreenSmall) {
                dataGrid.option('visible', false);
                cardView.option('visible', true);
            } else {
                cardView.option('visible', false);
                dataGrid.option('visible', true);
            }
        });
    })
</script>
